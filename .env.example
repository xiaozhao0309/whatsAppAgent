# ===== Twilio（WhatsApp 通道）=====
# 注册 https://www.twilio.com 后，Console 首页可看到这两个
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
# Sandbox 号码固定为 whatsapp:+14155238886；用正式号码时改成你自己的
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ===== Anthropic（LLM）=====
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# 可选：走 Anthropic 兼容端点时填（如火山方舟 https://ark.cn-beijing.volces.com/api/coding）；留空用官方
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-sonnet-5

# ===== Qdrant（向量库，本地文件模式）=====
QDRANT_PATH=./data/qdrant
QDRANT_COLLECTION=enterprise_kb

# ===== RAG 参数 =====
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=5
