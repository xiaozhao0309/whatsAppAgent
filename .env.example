# ===== Twilio（WhatsApp 通道）=====
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
# Sandbox 号码固定为 whatsapp:+14155238886；正式上线改成你自己的号码
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ===== 火山方舟 Ark（LLM）=====
ARK_API_KEY=your_ark_api_key
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=your_endpoint_or_model_id

# ===== Qdrant（向量库，本地文件模式）=====
QDRANT_PATH=./data/qdrant
QDRANT_COLLECTION=enterprise_kb

# ===== RAG 参数 =====
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=5
# 相似度阈值：低于此值判定为无相关内容并拒答；上线前用真实知识库标定
RAG_SCORE_THRESHOLD=0.5
# 单条回答最大字符数
ANSWER_MAX_CHARS=800

# ===== 会话（多轮对话）=====
# 滑动过期时间（秒），默认 7 天
SESSION_TTL_SECONDS=604800
# 保留最近 N 轮
SESSION_MAX_TURNS=10
# 送入模型的历史上下文最大字符数
SESSION_MAX_CHARS=2000

# ===== 防滥用 =====
# 单用户每分钟最多消息数
RATE_LIMIT_PER_MINUTE=10
# 单条入站消息最大字符数
MESSAGE_MAX_CHARS=2000

# ===== 转人工（值班号码，WhatsApp 格式 whatsapp:+...）=====
# 不配置则转人工功能降级为"暂无值班人员"
ON_DUTY_NUMBER=
ON_DUTY_FALLBACK_NUMBER=
