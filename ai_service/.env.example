# --- Volcano Ark LLM (OpenAI-compatible) ---
ARK_API_KEY=your_ark_api_key
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=your_endpoint_or_model_id

# --- Qdrant local vector store ---
QDRANT_PATH=./data/qdrant
QDRANT_COLLECTION=enterprise_kb

# --- RAG tuning ---
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=5
# Calibrate against the real KB before go-live (try 0.6-0.7).
RAG_SCORE_THRESHOLD=0.5
ANSWER_MAX_CHARS=800

# --- Source documents directory ---
DOCS_DIR=./app/sample_docs
