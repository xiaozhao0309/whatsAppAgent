# ===== Twilio (WhatsApp channel) =====
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
# Sandbox number is fixed as whatsapp:+14155238886; use your own number for production.
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ===== AI/RAG service (HTTP) =====
RAG_SERVICE_URL=http://localhost:8001
RAG_TIMEOUT=30

# ===== Sessions (multi-turn) =====
# Sliding expiry in seconds (default 7 days).
SESSION_TTL_SECONDS=604800
# Keep the most recent N turns.
SESSION_MAX_TURNS=10
# Max characters of history sent with each question.
SESSION_MAX_CHARS=2000

# ===== Anti-abuse =====
RATE_LIMIT_PER_MINUTE=10
MESSAGE_MAX_CHARS=2000

# ===== Hand-off to human (on-duty number in whatsapp:+... format) =====
# Leave unset to degrade gracefully to "no on-duty staff available".
ON_DUTY_NUMBER=
ON_DUTY_FALLBACK_NUMBER=
# 客户回复 agent（或连续答不出/报错）时，回复给客户的人工联系电话。
CONTACT_PHONE_NUMBER=020 1234567
# Auto hand-off after this many consecutive "no confident answer" results.
HANDOFF_MISS_THRESHOLD=2
# Auto hand-off after this many consecutive AI service errors/timeouts.
HANDOFF_ERROR_THRESHOLD=2
# When an answer's top_score is below this (but still above the AI service's
# own threshold), append a "reply agent to reach a human" hint. Set 0 to disable.
LOW_CONFIDENCE_SCORE=0.6
